<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1067" width="100%" height="100%">
  <defs>
    <!-- Background Gradient: Warm interior room with wooden wardrobe -->
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1A1816"/>
      <stop offset="40%" stop-color="#26211E"/>
      <stop offset="100%" stop-color="#141110"/>
    </linearGradient>

    <!-- Wood grain cupboard gradient -->
    <linearGradient id="woodGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#3A281E"/>
      <stop offset="50%" stop-color="#241812"/>
      <stop offset="100%" stop-color="#1B120E"/>
    </linearGradient>

    <!-- Yellow curtain reflection gradient -->
    <linearGradient id="curtainGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#F39C12" stop-opacity="0.05"/>
    </linearGradient>

    <!-- Gold Metallic Gradients -->
    <linearGradient id="goldMetallic" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#FFF2B2"/>
      <stop offset="25%" stop-color="#D4AF37"/>
      <stop offset="50%" stop-color="#F1C40F"/>
      <stop offset="75%" stop-color="#B8860B"/>
      <stop offset="100%" stop-color="#855D05"/>
    </linearGradient>

    <linearGradient id="goldSheen" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.6"/>
      <stop offset="50%" stop-color="#D4AF37" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.4"/>
    </linearGradient>

    <!-- Blue Trophy Metallic Gradient -->
    <linearGradient id="blueTrophy" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#00B4D8"/>
      <stop offset="35%" stop-color="#0077B6"/>
      <stop offset="70%" stop-color="#03045E"/>
      <stop offset="100%" stop-color="#0096C7"/>
    </linearGradient>

    <!-- Pramuka Uniform Khaki Brown -->
    <linearGradient id="uniformKhaki" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#A57D52"/>
      <stop offset="50%" stop-color="#8E653C"/>
      <stop offset="100%" stop-color="#734E29"/>
    </linearGradient>

    <!-- Skin Tone Gradient -->
    <linearGradient id="skinTone" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#C68652"/>
      <stop offset="50%" stop-color="#B07141"/>
      <stop offset="100%" stop-color="#965D32"/>
    </linearGradient>

    <!-- Drop Shadows -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
    <filter id="glowGold" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- 1. ROOM BACKGROUND -->
  <rect width="800" height="1067" fill="url(#bgGrad)"/>

  <!-- Dark Wooden Wardrobe / Cupboard in Background -->
  <rect x="60" y="30" width="680" height="980" rx="16" fill="url(#woodGrad)" stroke="#4A3528" stroke-width="4"/>
  <!-- Wardrobe Panel Lines -->
  <line x1="400" y1="30" x2="400" y2="1010" stroke="#1F1510" stroke-width="6"/>
  <!-- Left Door Inset Panels -->
  <rect x="90" y="70" width="280" height="420" rx="6" fill="#20150F" opacity="0.6" stroke="#4A3528" stroke-width="2"/>
  <rect x="90" y="520" width="280" height="460" rx="6" fill="#20150F" opacity="0.6" stroke="#4A3528" stroke-width="2"/>
  <!-- Right Door Inset / Mirror Panel with yellow curtain reflection -->
  <rect x="430" y="70" width="280" height="420" rx="6" fill="#1B140E" stroke="#4A3528" stroke-width="2"/>
  <rect x="435" y="75" width="270" height="410" fill="url(#curtainGrad)"/>
  <!-- Door Handles -->
  <rect x="375" y="470" width="10" height="90" rx="4" fill="#8E653C"/>
  <rect x="415" y="470" width="10" height="90" rx="4" fill="#8E653C"/>

  <!-- Trophies on top of cupboard (visible in original photo) -->
  <g opacity="0.85">
    <!-- Top Trophy 1 -->
    <path d="M 180,30 L 195,5 L 210,30 Z" fill="url(#goldMetallic)"/>
    <rect x="190" y="30" width="10" height="15" fill="#D4AF37"/>
    <!-- Top Trophy 2 (Cup) -->
    <path d="M 270,30 Q 285,10 300,30 Z" fill="url(#goldMetallic)"/>
    <!-- Top Trophy 3 (High star) -->
    <polygon points="360,5 365,18 378,18 368,26 372,39 360,30 348,39 352,26 342,18 355,18" fill="url(#goldMetallic)"/>
    <!-- Top Trophy 4 -->
    <path d="M 520,30 L 535,8 L 550,30 Z" fill="url(#goldMetallic)"/>
  </g>

  <!-- 2. STUDENT (ABIZAR RADINKA ANNAIL) -->
  <g id="student" filter="url(#shadow)">
    <!-- Hair -->
    <path d="M 330,300 C 320,250 360,220 415,220 C 470,220 515,250 505,300 C 510,340 500,360 495,370 C 485,340 480,320 475,310 C 455,300 375,300 355,310 C 350,320 345,340 335,370 Z" fill="#140E0A"/>

    <!-- Ears -->
    <ellipse cx="340" cy="355" rx="14" ry="24" fill="#A86A3C"/>
    <ellipse cx="490" cy="355" rx="14" ry="24" fill="#A86A3C"/>

    <!-- Face / Head -->
    <path d="M 345,310 C 345,260 485,260 485,310 C 485,380 470,430 415,445 C 360,430 345,380 345,310 Z" fill="url(#skinTone)"/>

    <!-- Eyebrows -->
    <path d="M 365,318 Q 385,312 400,318" stroke="#140E0A" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <path d="M 430,318 Q 445,312 465,318" stroke="#140E0A" stroke-width="4.5" stroke-linecap="round" fill="none"/>

    <!-- Eyes (Gentle, friendly, intelligent) -->
    <ellipse cx="382" cy="336" rx="8" ry="6" fill="#140E0A"/>
    <ellipse cx="448" cy="336" rx="8" ry="6" fill="#140E0A"/>
    <circle cx="380" cy="334" r="2.2" fill="#FFFFFF"/>
    <circle cx="446" cy="334" r="2.2" fill="#FFFFFF"/>

    <!-- Nose -->
    <path d="M 415,338 L 413,370 Q 415,375 422,374" stroke="#8E5528" stroke-width="3" stroke-linecap="round" fill="none"/>

    <!-- Confident gentle smile -->
    <path d="M 390,395 Q 415,410 440,395" stroke="#6D3D18" stroke-width="3.5" stroke-linecap="round" fill="none"/>

    <!-- Neck -->
    <rect x="390" y="430" width="50" height="60" fill="#9C6235"/>

    <!-- PRAMUKA KHAKI UNIFORM BODY -->
    <!-- Shoulders and Torso -->
    <path d="M 280,480 Q 415,460 550,480 L 590,900 L 240,900 Z" fill="url(#uniformKhaki)"/>

    <!-- Uniform Collar -->
    <polygon points="415,490 350,470 330,530 405,520" fill="#75502C" stroke="#5C3D20" stroke-width="2"/>
    <polygon points="415,490 480,470 500,530 425,520" fill="#75502C" stroke="#5C3D20" stroke-width="2"/>
    <!-- Collar V -->
    <polygon points="390,470 415,530 440,470" fill="#9C6235"/>

    <!-- Scout Badge (Purple Tunas Kelapa Pin on Right Chest) -->
    <rect x="365" y="555" width="28" height="28" rx="5" fill="#4A154B" stroke="#D4AF37" stroke-width="1.5"/>
    <circle cx="379" cy="569" r="8" fill="#D4AF37"/>

    <!-- Embroidered Name Tag: ABIZAR RADINKA A -->
    <rect x="340" y="590" width="85" height="18" rx="3" fill="#3D2614" stroke="#8E653C" stroke-width="1.5"/>
    <text x="382" y="602" font-family="Arial, sans-serif" font-size="7.5" font-weight="bold" fill="#FFF2B2" text-anchor="middle" letter-spacing="0.5">ABIZAR RADINKA A</text>

    <!-- Uniform Buttons -->
    <circle cx="415" cy="560" r="6" fill="#4A3119" stroke="#2D1C0E" stroke-width="1.5"/>
    <circle cx="415" cy="620" r="6" fill="#4A3119" stroke="#2D1C0E" stroke-width="1.5"/>
    <circle cx="415" cy="680" r="6" fill="#4A3119" stroke="#2D1C0E" stroke-width="1.5"/>

    <!-- Belt (Ikat Pinggang Pramuka) -->
    <rect x="290" y="840" width="250" height="35" fill="#1C140E"/>
    <rect x="395" y="835" width="40" height="45" rx="4" fill="url(#goldMetallic)" stroke="#855D05" stroke-width="2"/>
  </g>

  <!-- 3. MEDAL AROUND NECK (MEDALI EMAS BERUKIR) -->
  <g id="medal" filter="url(#shadow)">
    <!-- Tricolor Ribbon (Red, White, Blue Stripes like photo) -->
    <path d="M 370,475 Q 400,580 415,620 Q 430,580 460,475" stroke="#FFFFFF" stroke-width="16" fill="none" stroke-linecap="round"/>
    <path d="M 368,475 Q 398,580 413,620 Q 428,580 458,475" stroke="#C0392B" stroke-width="6" fill="none"/>
    <path d="M 374,475 Q 404,580 419,620 Q 434,580 464,475" stroke="#2980B9" stroke-width="6" fill="none"/>

    <!-- Gold Medal Pendant -->
    <circle cx="415" cy="640" r="28" fill="url(#goldMetallic)" stroke="#855D05" stroke-width="3" filter="url(#glowGold)"/>
    <circle cx="415" cy="640" r="22" fill="#D4AF37" stroke="#FFF2B2" stroke-width="1.5"/>
    <!-- Medal Embossed Center Icon -->
    <polygon points="415,624 419,634 430,634 421,641 424,651 415,645 406,651 409,641 400,634 411,634" fill="#855D05"/>
  </g>

  <!-- 4. RIGHT HAND & BLUE-GOLD TROPHY "JUARA I" -->
  <g id="trophy" filter="url(#shadow)">
    <!-- Right Arm holding trophy -->
    <path d="M 280,510 L 240,650 L 270,740 L 320,680" fill="url(#uniformKhaki)"/>
    <!-- Hand gripping trophy column -->
    <path d="M 265,680 C 275,670 310,680 305,720 C 300,740 270,735 265,710 Z" fill="url(#skinTone)"/>

    <!-- TROPHY STRUCTURE -->
    <!-- Base (Black Block) -->
    <polygon points="215,810 325,810 315,910 225,910" fill="#141414" stroke="#2B2B2B" stroke-width="2"/>
    <rect x="220" y="820" width="100" height="75" rx="3" fill="#1E1E1E"/>
    <!-- Trophy Plate Badge: "JUARA I" -->
    <rect x="232" y="830" width="76" height="55" rx="3" fill="#FFFFFF" stroke="#D4AF37" stroke-width="2"/>
    <!-- Red ribbon banner across base -->
    <rect x="237" y="870" width="66" height="10" rx="2" fill="#C0392B"/>
    <text x="270" y="852" font-family="Arial, sans-serif" font-weight="900" font-size="14" fill="#1A1615" text-anchor="middle">JUARA</text>
    <text x="270" y="868" font-family="Arial, sans-serif" font-weight="900" font-size="16" fill="#C0392B" text-anchor="middle">I</text>

    <!-- Metallic Gold Stem Base -->
    <path d="M 245,810 L 295,810 L 285,765 L 255,765 Z" fill="url(#goldMetallic)"/>
    <circle cx="270" cy="765" r="14" fill="url(#goldMetallic)"/>

    <!-- Metallic Blue Cup Body -->
    <path d="M 240,750 Q 230,680 235,630 Q 270,615 305,630 Q 310,680 300,750 Z" fill="url(#blueTrophy)" stroke="#00B4D8" stroke-width="2"/>
    <ellipse cx="270" cy="630" rx="35" ry="12" fill="#03045E" stroke="#00B4D8" stroke-width="2"/>

    <!-- Trophy Gold Handles on Sides -->
    <path d="M 235,640 Q 210,660 215,700 Q 220,730 242,735" fill="none" stroke="url(#goldMetallic)" stroke-width="6" stroke-linecap="round"/>
    <path d="M 305,640 Q 330,660 325,700 Q 320,730 298,735" fill="none" stroke="url(#goldMetallic)" stroke-width="6" stroke-linecap="round"/>

    <!-- Gold Star Crown Topper with Round Logo Insert -->
    <path d="M 255,620 L 285,620 L 280,560 L 260,560 Z" fill="url(#goldMetallic)"/>
    <!-- Trophy Star Figure -->
    <polygon points="270,450 278,475 305,475 284,492 291,518 270,502 249,518 256,492 235,475 262,475" fill="url(#goldMetallic)" filter="url(#glowGold)"/>
    <!-- Center Emblem on Trophy -->
    <circle cx="270" cy="490" r="18" fill="#FFF2B2" stroke="#D4AF37" stroke-width="2"/>
    <circle cx="270" cy="490" r="15" fill="#C0392B"/>
    <text x="270" y="494" font-family="Arial, sans-serif" font-weight="900" font-size="9" fill="#FFF2B2" text-anchor="middle">OSN</text>
  </g>

  <!-- 5. LEFT HAND & OFFICIAL CERTIFICATE -->
  <g id="certificate" filter="url(#shadow)">
    <!-- Left Hand Holding Certificate -->
    <path d="M 520,530 L 610,680 L 640,790" fill="url(#uniformKhaki)"/>
    <path d="M 600,750 C 610,740 640,750 635,780 C 630,800 610,795 600,775 Z" fill="url(#skinTone)"/>

    <!-- White Certificate Paper (Slightly tilted forward like in photo) -->
    <g transform="translate(460, 560) rotate(-2)">
      <!-- Certificate Sheet -->
      <rect x="0" y="0" width="310" height="235" rx="8" fill="#FFFFFF" stroke="#D4AF37" stroke-width="3"/>
      <!-- Decorative Inner Blue and Gold Border -->
      <rect x="8" y="8" width="294" height="219" rx="4" fill="#FAFCFF" stroke="#0077B6" stroke-width="1.5"/>
      <rect x="12" y="12" width="286" height="211" fill="none" stroke="#D4AF37" stroke-width="0.8" stroke-dasharray="4,2"/>

      <!-- Certificate Corner Ornaments -->
      <polygon points="12,12 30,12 12,30" fill="#0077B6"/>
      <polygon points="298,12 280,12 298,30" fill="#0077B6"/>
      <polygon points="12,223 30,223 12,205" fill="#0077B6"/>
      <polygon points="298,223 280,223 298,205" fill="#0077B6"/>

      <!-- Top Logos (OSN, LKP, Tut Wuri Handayani) -->
      <circle cx="95" cy="28" r="8" fill="#C0392B"/>
      <circle cx="115" cy="28" r="8" fill="#0077B6"/>
      <circle cx="135" cy="28" r="8" fill="#D4AF37"/>
      <text x="148" y="31" font-family="Arial, sans-serif" font-size="6.5" font-weight="bold" fill="#0077B6">LKP PRESTASI NUSANTARA</text>

      <!-- Certificate Title -->
      <text x="155" y="52" font-family="'Times New Roman', serif" font-size="14" font-weight="900" fill="#0077B6" text-anchor="middle" letter-spacing="1">SERTIFIKAT</text>
      <text x="155" y="64" font-family="Arial, sans-serif" font-size="8" font-weight="bold" fill="#D4AF37" text-anchor="middle" letter-spacing="1.5">PENGHARGAAN</text>

      <!-- Recipient Line -->
      <text x="155" y="77" font-family="Arial, sans-serif" font-size="6" fill="#666" text-anchor="middle">Dengan bangga dianugerahkan kepada:</text>

      <!-- Student Name: Abizar Radinka Annail -->
      <text x="155" y="98" font-family="'Georgia', serif" font-style="italic" font-size="15" font-weight="bold" fill="#0077B6" text-anchor="middle">Abizar Radinka Annail</text>
      <line x1="50" y1="102" x2="260" y2="102" stroke="#D4AF37" stroke-width="1"/>

      <!-- Champion Rank Banner -->
      <rect x="85" y="110" width="140" height="24" rx="4" fill="url(#goldMetallic)" stroke="#855D05" stroke-width="1"/>
      <text x="155" y="123" font-family="Arial, sans-serif" font-size="10" font-weight="900" fill="#1A1615" text-anchor="middle">JUARA I</text>
      <text x="155" y="131" font-family="Arial, sans-serif" font-size="6" font-weight="bold" fill="#1A1615" text-anchor="middle">BIDANG MATEMATIKA</text>

      <!-- Category -->
      <text x="155" y="146" font-family="Arial, sans-serif" font-size="7" font-weight="bold" fill="#333" text-anchor="middle">Kategori B (SD / MI — Usia 7 - 12 Tahun)</text>
      <text x="155" y="156" font-family="Arial, sans-serif" font-size="6" fill="#777" text-anchor="middle">Tingkat Nasional · Tanggal 4 Juli 2026</text>

      <!-- Bottom Details: QR Code & Stempel -->
      <!-- QR Code Simulation -->
      <g transform="translate(25, 170)">
        <rect x="0" y="0" width="34" height="34" fill="#FFFFFF" stroke="#0077B6" stroke-width="1"/>
        <rect x="3" y="3" width="10" height="10" fill="#0077B6"/>
        <rect x="21" y="3" width="10" height="10" fill="#0077B6"/>
        <rect x="3" y="21" width="10" height="10" fill="#0077B6"/>
        <rect x="5" y="5" width="6" height="6" fill="#FFFFFF"/>
        <rect x="23" y="5" width="6" height="6" fill="#FFFFFF"/>
        <rect x="5" y="23" width="6" height="6" fill="#FFFFFF"/>
        <!-- QR dots -->
        <rect x="15" y="7" width="3" height="3" fill="#0077B6"/>
        <rect x="15" y="15" width="4" height="4" fill="#0077B6"/>
        <rect x="15" y="23" width="3" height="3" fill="#0077B6"/>
        <rect x="21" y="15" width="6" height="3" fill="#0077B6"/>
        <rect x="23" y="23" width="6" height="6" fill="#0077B6"/>
        <text x="17" y="42" font-family="Arial, sans-serif" font-size="4.5" fill="#666" text-anchor="middle">VERIFIKASI RESMI</text>
      </g>

      <!-- Official Blue Stamp & Signature of Committee Chair -->
      <g transform="translate(210, 178)">
        <!-- Blue Round Stamp -->
        <circle cx="30" cy="10" r="22" fill="none" stroke="#0077B6" stroke-width="2" stroke-dasharray="3,1" opacity="0.8"/>
        <circle cx="30" cy="10" r="17" fill="none" stroke="#0077B6" stroke-width="1" opacity="0.8"/>
        <text x="30" y="4" font-family="Arial, sans-serif" font-size="4" font-weight="bold" fill="#0077B6" text-anchor="middle">OLIMPIADE OSN</text>
        <text x="30" y="18" font-family="Arial, sans-serif" font-size="3.5" font-weight="bold" fill="#0077B6" text-anchor="middle">LKP PRESTASI</text>

        <!-- Signature -->
        <path d="M 12,12 Q 25,-2 35,15 Q 45,2 52,10" stroke="#003566" stroke-width="1.8" fill="none"/>
        <line x1="5" y1="26" x2="55" y2="26" stroke="#0077B6" stroke-width="0.8"/>
        <text x="30" y="32" font-family="Arial, sans-serif" font-size="5" font-weight="bold" fill="#1A1615" text-anchor="middle">KETUA PANITIA OSN</text>
      </g>
    </g>
  </g>

  <!-- 6. TOP OFFICIAL BADGE OVERLAY -->
  <g transform="translate(40, 40)">
    <rect x="0" y="0" width="280" height="42" rx="21" fill="#1A1615" opacity="0.9" stroke="#D4AF37" stroke-width="2"/>
    <circle cx="21" cy="21" r="14" fill="#D4AF37"/>
    <text x="21" y="26" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#1A1615" text-anchor="middle">🥇</text>
    <text x="48" y="19" font-family="Arial, sans-serif" font-size="11" font-weight="900" fill="#FFF2B2">FOTO ASLI JUARA NASIONAL</text>
    <text x="48" y="32" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#D4AF37">OSN 2026 · LKP PRESTASI NUSANTARA</text>
  </g>
</svg>
