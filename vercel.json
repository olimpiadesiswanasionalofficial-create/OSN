{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/participants/fetch-spreadsheet",
      "destination": "/api/fetch-spreadsheet"
    },
    {
      "source": "/api/fetch-spreadsheet",
      "destination": "/api/fetch-spreadsheet"
    },
    {
      "source": "/api/participants/bulk",
      "destination": "/api/participants?action=bulk"
    },
    {
      "source": "/api/participants/clear",
      "destination": "/api/participants?action=clear"
    },
    {
      "source": "/api/participants/:id/reset",
      "destination": "/api/participants?action=reset&id=:id"
    },
    {
      "source": "/api/participants/:id/exam",
      "destination": "/api/participants?action=exam&id=:id"
    },
    {
      "source": "/api/participants/exam",
      "destination": "/api/participants?action=exam"
    },
    {
      "source": "/api/participants/:id",
      "destination": "/api/participants?id=:id"
    },
    {
      "source": "/api/participants",
      "destination": "/api/participants"
    },
    {
      "source": "/api/schedule-config",
      "destination": "/api/config?key=schedule_config"
    },
    {
      "source": "/api/meta-pixel",
      "destination": "/api/config?key=meta_pixel"
    },
    {
      "source": "/api/gallery",
      "destination": "/api/config?key=gallery_custom_images"
    },
    {
      "source": "/api/whatsapp-settings",
      "destination": "/api/config?key=whatsapp_api"
    },
    {
      "source": "/api/questions/:id",
      "destination": "/api/questions?id=:id"
    },
    {
      "source": "/api/questions",
      "destination": "/api/questions"
    },
    {
      "source": "/api/settings",
      "destination": "/api/config"
    },
    {
      "source": "/api/migrate",
      "destination": "/api/index?action=migrate"
    },
    {
      "source": "/api/sync/status",
      "destination": "/api/index?action=status"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/index?action=webhook"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ]
}
